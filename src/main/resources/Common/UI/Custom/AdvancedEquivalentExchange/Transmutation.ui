$C = "../Common.ui";

@Section = Label {
  Style: (FontSize: 15, RenderBold: true, TextColor: #ddb679, VerticalAlignment: Center);
};

@Note = Label {
  Style: (FontSize: 14, TextColor: #b8cbc7, VerticalAlignment: Center, Wrap: true);
};

Group #TableRoot {
  $C.@PageOverlay {}
  Group #TableFrame {
    Anchor: (Width: 980, Height: 676);
    $C.@Container {
      Anchor: (Full: 0);
      #Title { $C.@Title #Heading { @Text = "Transmutation Table"; } }
      #Content {
        LayoutMode: Full;
        Padding: (Full: 0);

        Group {
          Anchor: (Left: 16, Top: 12, Width: 278, Height: 328);
          Background: #19252b;
          Label #BurnTitle {
            Anchor: (Left: 12, Top: 8, Width: 254, Height: 26);
            Style: (FontSize: 15, RenderBold: true, TextColor: #ddb679, HorizontalAlignment: Center, VerticalAlignment: Center);
          }

          Group { Anchor: (Left: 123, Top: 91, Width: 32, Height: 32); Background: "Alchemy/Fire.png"; HitTestVisible: false; }
          Group { Anchor: (Left: 50, Top: 148, Width: 32, Height: 32); Background: "Alchemy/Earth.png"; HitTestVisible: false; }
          Group #BurnHost { Anchor: (Left: 109, Top: 134, Width: 60, Height: 60); }
          Group { Anchor: (Left: 196, Top: 148, Width: 32, Height: 32); Background: "Alchemy/Air.png"; HitTestVisible: false; }
          Group { Anchor: (Left: 123, Top: 205, Width: 32, Height: 32); Background: "Alchemy/Water.png"; HitTestVisible: false; }
        }

        Group {
          Anchor: (Left: 306, Top: 12, Width: 658, Height: 328);
          Background: #19252b;
          @Section #TradeTitle { Anchor: (Left: 12, Top: 8, Width: 230, Height: 26); }
          Label #Balance {
            Anchor: (Right: 12, Top: 6, Width: 330, Height: 30);
            Style: (FontSize: 22, RenderBold: true, TextColor: #f7cc81, HorizontalAlignment: End, VerticalAlignment: Center);
          }

          $C.@TextField #Search { Anchor: (Left: 12, Top: 42, Width: 355, Height: 34); }
          $C.@SmallSecondaryTextButton #Affordable { Anchor: (Left: 375, Top: 42, Width: 140, Height: 34); }
          $C.@SmallSecondaryTextButton #Limit { Anchor: (Left: 523, Top: 42, Width: 123, Height: 34); }
          Group #TradeHost { Anchor: (Left: 12, Top: 88, Width: 634, Height: 194); }
          Group #TradeTrack {
            Anchor: (Left: 12, Top: 274, Width: 634, Height: 8);
            Background: (TexturePath: "../Common/Scrollbar.png", Border: 3);
            HitTestVisible: false;
          }

          @Note #Selection { Anchor: (Left: 12, Top: 285, Width: 504, Height: 38); }
          $C.@SmallSecondaryTextButton #Forget { Anchor: (Left: 531, Top: 288, Width: 115, Height: 32); }
        }

        Group #PlayerPanel {
          Anchor: (Left: 16, Top: 354, Width: 948, Height: 268);
          Background: #19252b;
          Group #PlayerStorage {
            Anchor: (Left: 48, Top: 0, Width: 480, Height: 268);
            @Section #InventoryTitle { Anchor: (Left: 0, Top: 8, Width: 414, Height: 25); }
            Group #InventoryHost { Anchor: (Left: 0, Top: 39, Width: 414, Height: 176); }
            Group #HotbarHost { Anchor: (Left: 0, Top: 220, Width: 414, Height: 44); }
            @Note #HotbarTitle { Anchor: (Left: 416, Top: 220, Width: 64, Height: 44); }
          }
          @Section #BackpackTitle { Anchor: (Left: 504, Top: 8, Width: 414, Height: 25); }
          Group #BackpackHost { Anchor: (Left: 504, Top: 39, Width: 414, Height: 176); }
        }
      }
    }
    Group #PageTooltipHost { Anchor: (Full: 0); HitTestVisible: false; }
  }
  $C.@BackButton {}
}
